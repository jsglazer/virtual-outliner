{
	"name": "virtual-outliner",
	"version": "1.0.25",
	"description": "Outline-first authoring layer for Obsidian: a computed, collapsible outline over your prose in one Markdown file, with a real outliner keymap that never orphans body text.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "^5.0.0",
		"esbuild": "0.28.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"prettier": "^3.8.4",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.61.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@codemirror/state": "6.6.0",
		"@codemirror/view": "6.43.1",
		"obsidian": "1.8.7"
	}
}
